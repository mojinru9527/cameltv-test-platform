{
  "$defs": {
    "Artifact": {
      "additionalProperties": false,
      "description": "Immutable application artifact bound by digest and SBOM checksum.",
      "properties": {
        "digest": {
          "title": "Digest",
          "type": "string"
        },
        "image": {
          "minLength": 1,
          "title": "Image",
          "type": "string"
        },
        "sbom_sha256": {
          "title": "Sbom Sha256",
          "type": "string"
        }
      },
      "required": [
        "image",
        "digest",
        "sbom_sha256"
      ],
      "title": "Artifact",
      "type": "object"
    },
    "BackendArtifact": {
      "additionalProperties": false,
      "description": "Backend artifact evidence extends the shared artifact contract.",
      "properties": {
        "digest": {
          "title": "Digest",
          "type": "string"
        },
        "image": {
          "minLength": 1,
          "title": "Image",
          "type": "string"
        },
        "openapi_sha256": {
          "title": "Openapi Sha256",
          "type": "string"
        },
        "sbom_sha256": {
          "title": "Sbom Sha256",
          "type": "string"
        }
      },
      "required": [
        "image",
        "digest",
        "sbom_sha256",
        "openapi_sha256"
      ],
      "title": "BackendArtifact",
      "type": "object"
    },
    "DatabaseTarget": {
      "additionalProperties": false,
      "description": "Database revision target for one immutable release.",
      "properties": {
        "alembic_heads": {
          "items": {
            "type": "string"
          },
          "maxItems": 1,
          "minItems": 1,
          "title": "Alembic Heads",
          "type": "array"
        },
        "rollback_mode": {
          "pattern": "^application-rollback-or-forward-fix$",
          "title": "Rollback Mode",
          "type": "string"
        },
        "target_revision": {
          "minLength": 1,
          "title": "Target Revision",
          "type": "string"
        }
      },
      "required": [
        "alembic_heads",
        "target_revision",
        "rollback_mode"
      ],
      "title": "DatabaseTarget",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Validated immutable release unit; it deliberately contains no secret values.",
  "properties": {
    "backend": {
      "$ref": "#/$defs/BackendArtifact"
    },
    "config_schema": {
      "minLength": 1,
      "title": "Config Schema",
      "type": "string"
    },
    "database": {
      "$ref": "#/$defs/DatabaseTarget"
    },
    "frontend": {
      "$ref": "#/$defs/Artifact"
    },
    "git_sha": {
      "title": "Git Sha",
      "type": "string"
    },
    "qa_evidence": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Qa Evidence",
      "type": "array"
    },
    "release_id": {
      "pattern": "^[a-z0-9][a-z0-9-]{2,127}$",
      "title": "Release Id",
      "type": "string"
    },
    "schema_version": {
      "pattern": "^1\\.0$",
      "title": "Schema Version",
      "type": "string"
    },
    "secret_refs": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Secret Refs",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "release_id",
    "git_sha",
    "frontend",
    "backend",
    "database",
    "config_schema",
    "secret_refs",
    "qa_evidence"
  ],
  "title": "ReleaseManifest",
  "type": "object"
}
