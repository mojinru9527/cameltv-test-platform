{
 "chain_id": "CHAIN-ORDER-C-READONLY",
 "name": "订单-C 端域内链：订单列表→详情→可退金额→退款记录→购物车",
 "fixtures": [
  {
   "id": "f1",
   "name": "C 端最近订单",
   "method": "GET",
   "path": "/client/mall/orders?pageNum=1&pageSize=5",
   "auth": "client",
   "expect": {
    "code": 200
   },
   "extract": {
    "bno": "data[0].businessNo"
   }
  }
 ],
 "entry_gate": [
  "f1"
 ],
 "steps": [
  {
   "no": 1,
   "name": "订单详情",
   "method": "GET",
   "path": "/client/mall/orders/{bno}",
   "auth": "client",
   "expect": {
    "code": 200
   },
   "present": true,
   "absent_fields": [
    "openid",
    "sessionKey"
   ]
  },
  {
   "no": 2,
   "name": "可退金额",
   "method": "GET",
   "path": "/client/mall/orders/{bno}/refundable",
   "auth": "client",
   "expect": {
    "code_in": [
     200,
     4100
    ]
   },
   "note": "4100=业务拒绝（不可退），需业务确认文案"
  },
  {
   "no": 3,
   "name": "退款记录",
   "method": "GET",
   "path": "/client/mall/orders/{bno}/refunds",
   "auth": "client",
   "expect": {
    "code": 200
   }
  },
  {
   "no": 4,
   "name": "购物车",
   "method": "GET",
   "path": "/client/mall/cart",
   "auth": "client",
   "expect": {
    "code": 200
   },
   "present": true
  }
 ],
 "cleanup": [],
 "priority": "P0",
 "status": "ready",
 "domain": "订单-C端",
