{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "test-platform-v2/backend/Dockerfile"
  },
  "deploy": {
    "healthcheckPath": "/api/v1/open/health",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
