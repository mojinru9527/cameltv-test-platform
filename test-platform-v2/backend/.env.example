# ============================================================
# CamelTv 测试平台 v2 — 环境变量配置模板
# 复制为 .env 并填入真实值（.env 已加入 .gitignore）
# ============================================================
#
# 长期运行的 local/production 实例请从以下模板创建一次真实配置：
#   ../config/runtime/<target>.env.example -> ../config/runtime/<target>.env
# 每个实例固定访问地址和独立数据库，切换浏览器地址即可；数据库配置变更后
# 必须重启后端，不支持在页面内热切数据库。
#
# 本文件仍用于临时单实例和独立 Agent worktree，复制为 backend/.env 即可。

# ── 运行模式 ──
# development: 开发模式，允许弱默认值（仅供本地）
# production:  生产模式，强制校验密钥/密码必填
ENVIRONMENT=development

# 登录限流（C70-3）：生产默认 10 次/900s；development/test 自动放宽到 >=100 次/窗口
# LOGIN_RATE_LIMIT_MAX=10
# LOGIN_RATE_LIMIT_WINDOW_SECONDS=900

# ── 应用 ──
APP_NAME=CamelTv Test Platform API
APP_VERSION=2.1.0

# ── 安全（生产必填；本地验收也应显式设置）──────────
# SECRET_KEY: JWT 签名密钥，生产环境和可重复本地验收务必使用强随机字符串
#   生成方法: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
# ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── 数据库 ──────────────────
# SQLite (默认) : sqlite:///./data/platform.db
# PostgreSQL    : postgresql://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///./data/platform.db
# DB_POOL_SIZE=10             # PostgreSQL 连接池（仅 PG 模式生效）
# DB_MAX_OVERFLOW=20

# ── CORS ───────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── 默认管理员（生产必改）────
# 密码留空时仅在首次创建种子用户时自动生成并显示一次；重启不会替换已存在账号的密码。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ── 默认测试用户（种子数据）────
# 密码留空时仅在首次创建种子用户时自动生成并显示一次；重启不会替换已存在账号的密码。
TESTER_USERNAME=tester
TESTER_PASSWORD=

# 前端正式域名（Batch 109）：项目邀请等可分享链接使用；空=回退请求域名
FRONTEND_URL=
# 是否创建内置演示账号（tester/viewer）；生产外放建议 false
SEED_DEMO_USERS=true

# ── AI / LLM（DeepSeek 兼容 OpenAI 协议）────
AI_ENABLED=true
AI_API_BASE_URL=https://api.deepseek.com
AI_API_KEY=
AI_MODEL=deepseek-v4-pro
AI_MAX_TOKENS=8192
AI_TEMPERATURE=0.3

# ── ELK / 日志排障 ─────────
ELK_BASE_URL=
ELK_INDEX=*

# ── 蓝湖提取（可选）─────────
# 优先使用 COOKIE（手动从浏览器复制）；若 Cookie 过期可配置账密自动登录
LANHU_COOKIE=
LANHU_USERNAME=
LANHU_PASSWORD=

# ── 文件路径（可选，留空=自动检测）────
# WORKSPACE_ROOT=F:/CamelTv
# SKILL_DIR=F:/CamelTv/.claude/skills/test-case-design
# DATA_DIR=F:/CamelTv/test-platform-v2/backend/data

# ── 调度与通知（SMTP 使用 587 + STARTTLS）────
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=noreply@example.com
# SMTP_PASSWORD=
# SMTP_FROM=noreply@example.com
# SMTP_USE_TLS=true
# SMTP_VERIFY_CERT=true
# SMTP_CA_BUNDLE=

# ── DeepSeek Harness（dsh）执行型智能体（Batch 172）────
# A/B/C 三功能共用；默认关闭，开启后平台可真实执行任务（成本更高，需谨慎）。
DSH_ENABLED=false
DSH_RUNTIME=node                # node（本地 Windows 开发） | python-sdk（生产 Linux）
DSH_MODEL=deepseek-v4-flash
DSH_BASE_URL=                   # 空 = 复用 AI_API_BASE_URL
DSH_API_KEY=                    # 空 = 复用 AI_API_KEY
DSH_SESSION_ROOT=               # 空 = backend/storage/dsh-sessions
DSH_HARNESS_PATH=               # node runtime 的 dsh CLI 入口（如 F:\deepseek-harness\apps\cli\lib\bin.js）
DSH_CORDIS_CONFIG=              # python-sdk runtime 的 cordis 配置；空 = 内置 minimal 配置
DSH_TIMEOUT_SECONDS=600
DSH_MAX_OUTPUT_CHARS=20000
DSH_WORKSPACE=                  # 隔离根；空 = session_root/workspaces（每任务强制 ws-{uuid} 子目录）
# Batch 184（C172-1）沙箱加固：
DSH_MAX_CONCURRENT=1             # 全局并发 DSH 任务上限（安全优先默认串行）
DSH_MAX_TASK_CHARS=20000         # 单任务文本长度上限（超限拒绝）
# Batch 191（AgentTeams 团队模式）：
DSH_TEAM_TIMEOUT_SECONDS=1800    # 团队任务超时（覆盖单任务 600s）
DSH_TEAM_POLL_SECONDS=3          # 团队进度轮询间隔（前端详情 3s 粒度）
DSH_TEAM_PROFILE=agent-team      # node runtime 团队 profile 名（$DSH_HOME/profiles/agent-team）
DSH_TEAM_CORDIS_CONFIG=          # python-sdk 团队 cordis 路径；空 = 内置 team.cordis.yml
DSH_TEAM_HARNESS_PATH=           # 团队 profile 的 DSH_HOME 覆盖；空 = CLI 默认 $DSH_HOME（Windows: %USERPROFILE%\.dsh）
