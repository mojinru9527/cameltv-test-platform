# ============================================================
# CamelTv 测试平台 v2 — 环境变量配置模板
# 复制为 .env 并填入真实值（.env 已加入 .gitignore）
# ============================================================
#
# 长期运行的 local/production 实例请从以下模板创建一次真实配置：
#   ../config/runtime/<target>.env.example -> ../config/runtime/<target>.env
# 每个实例固定访问地址和独立数据库，切换浏览器地址即可；数据库配置变更后
# 必须重启后端，不支持在页面内热切数据库。
#
# 本文件仍用于临时单实例和独立 Agent worktree，复制为 backend/.env 即可。

# ── 运行模式 ──
# development: 开发模式，允许弱默认值（仅供本地）
# production:  生产模式，强制校验密钥/密码必填
ENVIRONMENT=development

# Keep combined execution until synchronous heavy routes are migrated.
WORKER_EXECUTION_ENABLED=true
# API-only role forwards registered synchronous execution routes here.
# RUNNER_HTTP_URL=http://runner:8000
# Runner catch-up of unembedded knowledge at 03:31 Asia/Shanghai.
KNOWLEDGE_EMBEDDING_SCHEDULE_ENABLED=false
HEAVY_TASK_BUDGET_ENABLED=false
HEAVY_TASK_BUDGET_CAPACITY=1
ORCHESTRATION_BUDGET_CAPACITY=1
# All same-host runners must mount the same local directory before enabling.
# HEAVY_TASK_BUDGET_DIR=/app/storage/resource-budget

# 登录限流（C70-3）：生产默认 10 次/900s；development/test 自动放宽到 >=100 次/窗口
# LOGIN_RATE_LIMIT_MAX=10
# LOGIN_RATE_LIMIT_WINDOW_SECONDS=900

# 模块可见性开关（P1a）：逗号分隔的菜单 code，软下线侧边栏与访客目录入口
# （页面路由保留可直达）。默认隐藏通知配置/集成配置（缺真实端点的占位页）。
# 恢复全部入口：DISABLED_MENUS=
# DISABLED_MENUS=menu:notify,menu:integration

# ── 应用 ──
APP_NAME=CamelTv Test Platform API
APP_VERSION=2.1.0

# ── 安全（生产必填；本地验收也应显式设置）──────────
# SECRET_KEY: JWT 签名密钥，生产环境和可重复本地验收务必使用强随机字符串
#   生成方法: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
# ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── 数据库 ──────────────────
# SQLite (默认) : sqlite:///./data/platform.db
# PostgreSQL    : postgresql://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///./data/platform.db
# DB_POOL_SIZE=10             # PostgreSQL 连接池（仅 PG 模式生效）
# DB_MAX_OVERFLOW=20

# ── CORS ───────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Comma-separated trusted reverse-proxy addresses. Compose keeps backend private
# behind Nginx; use explicit Docker network CIDRs when possible.
FORWARDED_ALLOW_IPS=127.0.0.1

# ── 默认管理员（生产必改）────
# 密码留空时仅在首次创建种子用户时自动生成并显示一次；重启不会替换已存在账号的密码。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ── 默认测试用户（种子数据）────
# 密码留空时仅在首次创建种子用户时自动生成并显示一次；重启不会替换已存在账号的密码。
TESTER_USERNAME=tester
TESTER_PASSWORD=

# 前端正式域名（Batch 109）：项目邀请等可分享链接使用；空=回退请求域名
FRONTEND_URL=
# 是否创建内置演示账号（tester/viewer）；生产外放建议 false
SEED_DEMO_USERS=true

# ── AI / LLM（DeepSeek 兼容 OpenAI 协议）────
# ⚠️ Batch A 起：AI_API_KEY / AI_API_BASE_URL / AI_MODEL 已退役，凭据迁移至平台内「AI 配置」
# （项目级提供方池，见 CLAUDE.md「AI 模型配置中心」）；未配置提供方的项目 AI 功能按设计禁用。
# ── Execution security boundary ───────────────
# User-influenced Playwright/Node workers run with a minimal env and POSIX limits.
EXECUTION_SANDBOX_ENABLED=true
EXECUTION_CPU_LIMIT_SECONDS=300
EXECUTION_MEMORY_LIMIT_MB=2048
EXECUTION_FILE_SIZE_LIMIT_MB=128
EXECUTION_OPEN_FILES_LIMIT=4096
EXECUTION_PROCESS_LIMIT=256
# Actual streamed request body cap (Content-Length is only a fast path).
MAX_REQUEST_BODY_BYTES=104857600
# Bounded outbound OpenAPI/spec imports.
OUTBOUND_REQUEST_TIMEOUT_SECONDS=20
OUTBOUND_MAX_REDIRECTS=5
OUTBOUND_MAX_RESPONSE_BYTES=10485760
AI_ENABLED=true
AI_API_BASE_URL=https://api.deepseek.com   # 已退役，仅保留作迁移参考；配置请走平台「AI 配置」
AI_API_KEY=                                 # 已退役，仅保留作迁移参考；配置请走平台「AI 配置」
AI_MODEL=deepseek-v4-pro                    # 已退役，仅保留作迁移参考；配置请走平台「AI 配置」
AI_MAX_TOKENS=8192
AI_TEMPERATURE=0.3
AI_EXACT_CACHE_ENABLED=false
AI_EXACT_CACHE_TTL_SECONDS=86400
AI_LOCAL_RUNTIME_ENABLED=false
AI_RUNTIME_MODE=cloud_only
AI_LOCAL_FALLBACK_TO_CLOUD=true
AI_LOCAL_BASE_URL=http://127.0.0.1:11434/v1
AI_LOCAL_API_KEY=
AI_LOCAL_MODEL=
AI_SHADOW_ENABLED=false
AI_SHADOW_SAMPLE_RATE=0.0
AI_SHADOW_TIMEOUT_SECONDS=60
AI_SHADOW_MAX_OUTPUT_CHARS=200000

# ── 蓝湖提取（可选）─────────
# 优先使用 COOKIE（手动从浏览器复制）；若 Cookie 过期可配置账密自动登录
LANHU_COOKIE=
LANHU_USERNAME=
LANHU_PASSWORD=

# ── 蓝湖证据 OCR 与截图（可选，默认内置 rapidocr）──
# OCR 命令模板，{image} 为截图路径；默认指向内置 rapidocr CLI，可替换外部引擎
# LANHU_OCR_COMMAND={python} -m app.services.lanhu_evidence.rapidocr_cli --image "{image}"
# 截图 DPR，默认 2.0（小字更清晰，提高 OCR 命中率）
# LANHU_CAPTURE_DEVICE_SCALE_FACTOR=2.0

# ── 文件路径（可选，留空=自动检测）────
# WORKSPACE_ROOT=F:/CamelTv
# SKILL_DIR=F:/CamelTv/.claude/skills/test-case-design
# DATA_DIR=F:/CamelTv/test-platform-v2/backend/data

# ── 调度与通知（SMTP 使用 587 + STARTTLS，仅用于密码重置邮件）────
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=noreply@example.com
# SMTP_PASSWORD=
# SMTP_FROM=noreply@example.com
# SMTP_USE_TLS=true
# SMTP_VERIFY_CERT=true
# SMTP_CA_BUNDLE=

