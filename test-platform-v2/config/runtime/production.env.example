# CamelTv production runtime profile.
# Reserved template only: the production server is not provisioned in Batch 57.
# Do not copy this file to production.env until the server, domain, TLS and
# PostgreSQL instance have been allocated.
# Replace every change-me/example.com value before a future deployment.
# Production startup requires an explicit confirmation in the runtime launcher.
PLATFORM_TARGET=production
PLATFORM_FRONTEND_URL=https://platform.example.com
COMPOSE_PROJECT_NAME=cameltv-tp-production
FRONTEND_PORT=80
BACKEND_PORT=8000

ENVIRONMENT=production
DATABASE_URL=postgresql://cameltv:change-me-production-postgres@postgres:5432/cameltv_production
AUTO_CREATE_TABLES=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
POSTGRES_USER=cameltv
POSTGRES_PASSWORD=change-me-production-postgres
POSTGRES_DB=cameltv_production
ALLOWED_ORIGINS=https://platform.example.com
CSRF_ALLOWED_ORIGINS=https://platform.example.com
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
COOKIE_PATH=/api

SECRET_KEY=change-me-production-secret-key
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-production-admin-password
TESTER_USERNAME=tester
TESTER_PASSWORD=change-me-production-tester-password
AI_ENABLED=false
# M1 知识源入库总开关（Batch 108：生产显式开启，capture/需求/接口/用例可入库）
KNOWLEDGE_INGEST_ENABLED=true
KNOWLEDGE_INGEST_PRODUCTION_DATA=false

# ── 外放/租户（Batch 104-106）生产开关 ──
# 默认开放普通用户注册；受控环境可关闭注册或显式开启平台邀请码。
REGISTRATION_ENABLED=true
INVITE_CODE_REQUIRED=false
# 注册用户的默认全局角色（外放用户按 tester 业务权限使用）
DEFAULT_REGISTRATION_ROLE=tester
# 资源配额护栏（个人项目数 / 团队组织数上限）
MAX_PROJECTS_PER_USER=5
MAX_TEAM_ORGANIZATIONS_PER_USER=5
# 注册限流（5 次/15 分钟；如需更高灰度阈值请显式调整，不建议低于 3）
REGISTER_RATE_LIMIT_MAX=5
REGISTER_RATE_LIMIT_WINDOW_SECONDS=900

# 前端正式域名（Batch 109）：项目邀请等可分享链接使用；生产必须配置正式前端地址。
FRONTEND_URL=https://platform.example.com
# 是否创建内置演示账号（tester/viewer）。生产外放后建议 false，避免部署时重建验收账号。
SEED_DEMO_USERS=true
