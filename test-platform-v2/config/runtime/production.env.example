# CamelTv production runtime profile — 腾讯云广州单机部署版（Batch：腾讯云迁移）
# 迁移手册: docs/ops/tencent-cloud-migration.md
# 目标: 腾讯云广州轻量服务器 + Docker Compose（Nginx 前端 + FastAPI 后端 + PostgreSQL 16）
# 域名: swiftbugs.cn（个人 ICP 备案中；备案通过前勿对外放行 80/443）
#
# 用法:
#   cp config/runtime/production.env.example config/runtime/production.env
#   替换所有 change-me / example 值；生产启动需要 -ConfirmProduction 显式确认。
#   ⚠️ 该文件含真实凭据，已被 Git 忽略，禁止提交。
PLATFORM_TARGET=production
PLATFORM_FRONTEND_URL=https://swiftbugs.cn
COMPOSE_PROJECT_NAME=cameltv-tp-production
FRONTEND_PORT=80
BACKEND_PORT=8000

ENVIRONMENT=production
# 本机 postgres 容器（compose 服务名 postgres:5432）；密码必须 URL 编码（如 @ → %40）
DATABASE_URL=postgresql://cameltv:change-me-urlencoded-postgres-password@postgres:5432/cameltv_production
AUTO_CREATE_TABLES=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
POSTGRES_USER=cameltv
POSTGRES_PASSWORD=change-me-production-postgres
POSTGRES_DB=cameltv_production
ALLOWED_ORIGINS=https://swiftbugs.cn
CSRF_ALLOWED_ORIGINS=https://swiftbugs.cn
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
COOKIE_PATH=/api

SECRET_KEY=change-me-production-secret-key
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-production-admin-password
TESTER_USERNAME=tester
TESTER_PASSWORD=change-me-production-tester-password

# ── 前端正式域名（Batch 109）：项目邀请等可分享链接使用；生产必须配置正式前端地址。
FRONTEND_URL=https://swiftbugs.cn
# 是否创建内置演示账号（tester/viewer）。生产外放后建议 false，避免部署时重建验收账号。
SEED_DEMO_USERS=false

# ── 备案号 footer（可选，构建前端镜像时注入）──
# 广东个人备案通过后回填，例如 粤ICP备XXXXXXXX号-1；页面底部展示并链接 beian.miit.gov.cn。
# 未配置则不显示 footer（docker compose build frontend 时读取）。
VITE_ICP_NUMBER=

# ── 外放/租户（Batch 104-106）生产开关 ──
# 默认开放普通用户注册；受控环境可关闭注册或显式开启平台邀请码。
REGISTRATION_ENABLED=true
INVITE_CODE_REQUIRED=false
# 注册用户的默认全局角色（外放用户按 tester 业务权限使用）
DEFAULT_REGISTRATION_ROLE=tester
# 资源配额护栏（个人项目数 / 团队组织数上限）
MAX_PROJECTS_PER_USER=5
MAX_TEAM_ORGANIZATIONS_PER_USER=5
# 注册限流（5 次/15 分钟；如需更高灰度阈值请显式调整，不建议低于 3）
REGISTER_RATE_LIMIT_MAX=5
REGISTER_RATE_LIMIT_WINDOW_SECONDS=900

# ── M1 知识源入库（Batch 108）：生产显式开启 ──
AI_ENABLED=false
AI_API_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=
AI_MODEL=deepseek-v4-pro
AI_MAX_TOKENS=8192
AI_TEMPERATURE=0.3
KNOWLEDGE_INGEST_ENABLED=true
KNOWLEDGE_INGEST_PRODUCTION_DATA=false
RAG_ENABLED=true
KNOWLEDGE_GRAPH_ENABLED=true
WIKI_ENABLED=true
WIKI_AUTO_INGEST_ENABLED=true
WIKI_DIFF_ENABLED=true
LANHU_MCP_ENABLED=true
EMBEDDING_CACHE_DIR=/data/models/fastembed
LANHU_EVIDENCE_ENABLED=true
LANHU_OCR_PROVIDER=local

# ── 蓝湖证据包存储（Batch 140）──
# 证据截图/导出默认落在 /app/storage/lanhu-evidence（容器内）。生产必须用持久卷挂载 /app/storage，
# 否则每次部署重建会清空旧截图（表现为"资产文件缺失 404"）。迁移见 docs/ops/tencent-cloud-migration.md §6。
LANHU_EVIDENCE_STORAGE_DIR=/app/storage/lanhu-evidence

# ── 蓝湖自动登录（可选）──
LANHU_COOKIE=
LANHU_USERNAME=
LANHU_PASSWORD=

# ── ELK/Kibana（可选，traceId 链路追踪）──
ELK_BASE_URL=
ELK_INDEX=*

# ── SMTP（可选；也可在 Web 通知中心用钉钉/飞书/企业微信 Webhook）──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
