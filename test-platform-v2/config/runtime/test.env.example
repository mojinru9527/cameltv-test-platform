# CamelTv shared test runtime profile.
# Copy to test.env and replace every change-me value before the first deployment.
# HTTPS must terminate at the configured test hostname.
PLATFORM_TARGET=test
PLATFORM_FRONTEND_URL=https://test-platform.example.com
COMPOSE_PROJECT_NAME=cameltv-tp-test
FRONTEND_PORT=5174
BACKEND_PORT=8001

ENVIRONMENT=production
DATABASE_URL=postgresql://cameltv:change-me-test-postgres@postgres:5432/cameltv_test
AUTO_CREATE_TABLES=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
POSTGRES_USER=cameltv
POSTGRES_PASSWORD=change-me-test-postgres
POSTGRES_DB=cameltv_test
ALLOWED_ORIGINS=https://test-platform.example.com
CSRF_ALLOWED_ORIGINS=https://test-platform.example.com
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
COOKIE_PATH=/api

SECRET_KEY=change-me-test-secret-key
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-test-admin-password
TESTER_USERNAME=tester
TESTER_PASSWORD=change-me-test-tester-password
AI_ENABLED=false
KNOWLEDGE_INGEST_PRODUCTION_DATA=false
