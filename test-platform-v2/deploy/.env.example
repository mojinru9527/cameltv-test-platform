# CamelTv 测试平台 v2 — 兼容单实例安全部署模板
# 长期 production 实例优先复制 ../config/runtime/production.env.example；
# 本文件仍可复制为 .env 运行单套 Compose。真实配置已被 Git 忽略，禁止提交。

ENVIRONMENT=production
COOKIE_SECURE=true

# 必填：JWT 密钥与首批账号密码。所有值使用独立强随机字符串。
SECRET_KEY=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
TESTER_USERNAME=tester
TESTER_PASSWORD=

# 前端正式域名（Batch 109）：项目邀请等可分享链接使用；空=回退请求域名
FRONTEND_URL=
# 是否创建内置演示账号（tester/viewer）；生产外放建议 false
SEED_DEMO_USERS=true

# 前端端口
FRONTEND_PORT=80

# CORS 允许的来源（逗号分隔）
ALLOWED_ORIGINS=https://platform.example.com

# 必填：使用 URL 编码后的 PostgreSQL 密码；生产 Compose 不回退 SQLite。
DATABASE_URL=postgresql://cameltv:<URL编码后的密码>@postgres:5432/cameltv

# ── PostgreSQL 连接池 ──
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20

# ── PostgreSQL 服务凭据 ──
POSTGRES_USER=cameltv
POSTGRES_PASSWORD=
POSTGRES_DB=cameltv

# ELK/Kibana 配置（可选，用于 traceId 链路追踪）
ELK_BASE_URL=
ELK_INDEX=*

# AI 功能可选；未配置 Key 时保持关闭。RAG 本地向量检索不依赖外部 AI Key。
AI_ENABLED=false
AI_API_BASE_URL=https://api.deepseek.com
AI_API_KEY=
AI_MODEL=deepseek-v4-pro
AI_MAX_TOKENS=8192
AI_TEMPERATURE=0.3

# ── DeepSeek Harness（DSH 测试 Agent 框架）──
# 启用 DSH 任务/团队执行（backend 镜像已内置 DSH 运行时，见 #282）
DSH_ENABLED=false
# node（Windows 本地开发）| python-sdk（生产 Linux）
DSH_RUNTIME=python-sdk
DSH_MODEL=deepseek-v4-flash
# DSH 测试 Agent 模型池（逗号分隔，如 deepseek-v4-flash,deepseek-v4-pro）；
# 空 = 不限模型（平台「新建 DSH 任务」模型下拉按此渲染，池外模型拒绝提交）
DSH_MODEL_POOL=deepseek-v4-flash,deepseek-v4-pro
# 空 = 复用 AI_API_BASE_URL / AI_API_KEY（DeepSeek 兼容端点）
DSH_BASE_URL=
DSH_API_KEY=
# ── 存储保留期清理（生产磁盘防护）──
# Railway 卷（/app/storage）曾被 ui-runs/dsh-sessions 累积写满导致 DSH 任务 ENOSPC；
# 按 mtime 清理超过 STORAGE_RETENTION_DAYS 天的旧产物（ui-runs 运行目录 + ws-* 工作区 + 会话 jsonl）
STORAGE_RETENTION_ENABLED=true
STORAGE_RETENTION_DAYS=7
STORAGE_RETENTION_HOUR=2
STORAGE_RETENTION_MINUTE=30
# 团队任务超时与心跳（stale 回收 300s 防误回收长任务）
DSH_TEAM_TIMEOUT_SECONDS=1800
DSH_TEAM_HEARTBEAT_SECONDS=60
# 全局并发 DSH 任务上限（安全优先，生产建议保持 1-2）
DSH_MAX_CONCURRENT=1

# 蓝湖可选；Cookie、账号和密码都只写在本地 .env。
LANHU_COOKIE=
LANHU_USERNAME=
LANHU_PASSWORD=

# RAG / Wiki / 证据采集
KNOWLEDGE_INGEST_ENABLED=true
RAG_ENABLED=true
KNOWLEDGE_GRAPH_ENABLED=true
WIKI_ENABLED=true
WIKI_AUTO_INGEST_ENABLED=true
WIKI_DIFF_ENABLED=true
KNOWLEDGE_INGEST_PRODUCTION_DATA=false
LANHU_MCP_ENABLED=true
EMBEDDING_CACHE_DIR=/data/models/fastembed
LANHU_EVIDENCE_ENABLED=true
LANHU_OCR_PROVIDER=local

# SMTP 可选；也可以在 Web 通知中心使用钉钉/飞书/企业微信 Webhook。
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
