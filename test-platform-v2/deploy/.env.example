# CamelTv 测试平台 v2 — 兼容单实例安全部署模板
# 长期 production 实例优先复制 ../config/runtime/production.env.example；
# 本文件仍可复制为 .env 运行单套 Compose。真实配置已被 Git 忽略，禁止提交。
#
# 平台简化批次：AITDE/DSH/ai-gateway 独立服务已删除；AI 为平台直连模式，
# AI_API_KEY 由 backend 进程持有。

ENVIRONMENT=production
COOKIE_SECURE=true

# 必填：JWT 密钥与首批账号密码。所有值使用独立强随机字符串。
SECRET_KEY=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
TESTER_USERNAME=tester
TESTER_PASSWORD=

# 前端正式域名（Batch 109）：项目邀请等可分享链接使用；空=回退请求域名
FRONTEND_URL=
# 是否创建内置演示账号（tester/viewer）；生产外放建议 false
SEED_DEMO_USERS=true

# 前端端口
FRONTEND_PORT=80

# CORS 允许的来源（逗号分隔）
ALLOWED_ORIGINS=https://platform.example.com
# Backend is private behind Nginx in the Compose network. Replace * with the
# Docker subnet/CIDR when the deployment exposes the backend directly.
FORWARDED_ALLOW_IPS=*
EXECUTION_SANDBOX_ENABLED=true
EXECUTION_CPU_LIMIT_SECONDS=300
EXECUTION_MEMORY_LIMIT_MB=2048
MAX_REQUEST_BODY_BYTES=104857600
OUTBOUND_MAX_RESPONSE_BYTES=10485760

# 必填：使用 URL 编码后的 PostgreSQL 密码；生产 Compose 不回退 SQLite。
DATABASE_URL=postgresql://cameltv:<URL编码后的密码>@postgres:5432/cameltv

# ── PostgreSQL 连接池 ──
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20

# ── PostgreSQL 服务凭据 ──
POSTGRES_USER=cameltv
POSTGRES_PASSWORD=
POSTGRES_DB=cameltv

# AI 功能可选；未配置 Key 时保持关闭。RAG 本地向量检索不依赖外部 AI Key。
AI_ENABLED=false
AI_API_BASE_URL=https://api.deepseek.com
AI_API_KEY=
AI_MODEL=deepseek-v4-pro
AI_MAX_TOKENS=8192
AI_TEMPERATURE=0.3
AI_EXACT_CACHE_ENABLED=false
AI_EXACT_CACHE_TTL_SECONDS=86400
AI_LOCAL_RUNTIME_ENABLED=false
AI_RUNTIME_MODE=cloud_only
AI_LOCAL_FALLBACK_TO_CLOUD=true
AI_LOCAL_BASE_URL=http://127.0.0.1:11434/v1
AI_LOCAL_API_KEY=
AI_LOCAL_MODEL=
AI_SHADOW_ENABLED=false
AI_SHADOW_SAMPLE_RATE=0.0
AI_SHADOW_TIMEOUT_SECONDS=60
AI_SHADOW_MAX_OUTPUT_CHARS=200000
# ── 平台级 AI 配额闸门（P1-6：按项目统计 model_usage_ledger）──
AI_GUARD_ENABLED=true
# 每项目每分钟 AI 请求上限；默认 60 以容纳「大文档生成用例」的合法突发
# （抽取块 + 生成块 + 截断重试 ≈ 30 次），同时仍能拦住失控循环。
AI_RATE_LIMIT_PER_MINUTE=60
# 每项目 24 小时 token 预算（input_units + output_units）；真正的花费上限。
AI_DAILY_TOKEN_BUDGET=2000000

# ── 存储保留期清理（生产磁盘防护）──
# 按 mtime 清理超过 STORAGE_RETENTION_DAYS 天的旧产物（ui-runs 运行目录等）
STORAGE_RETENTION_ENABLED=true
STORAGE_RETENTION_DAYS=7
STORAGE_RETENTION_HOUR=2
STORAGE_RETENTION_MINUTE=30
# 是否一并清理 plan-sync 过期子目录（与计划执行历史关联，默认 false）
STORAGE_RETENTION_INCLUDE_PLAN_SYNC=false

# 蓝湖可选；Cookie、账号和密码都只写在本地 .env。
LANHU_COOKIE=
LANHU_USERNAME=
LANHU_PASSWORD=

# RAG / Wiki / 证据采集
KNOWLEDGE_INGEST_ENABLED=true
RAG_ENABLED=true
WIKI_ENABLED=true
WIKI_AUTO_INGEST_ENABLED=true
KNOWLEDGE_INGEST_PRODUCTION_DATA=false
LANHU_MCP_ENABLED=true
EMBEDDING_CACHE_DIR=/data/models/fastembed
LANHU_EVIDENCE_ENABLED=true
LANHU_OCR_PROVIDER=local

# SMTP 可选（仅用于密码重置邮件）
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
