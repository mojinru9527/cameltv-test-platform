# AITDE V3.4 Durable Runtime — 配置样例（test 本地 / prod 云服务器）
# 复制为 .env 并按环境填写。敏感值（密钥/证书路径）不提交仓库。
#
# 对应 backend app/core/config.py 的 temporal_* 字段。

# ── Temporal 连接 ──
TEMPORAL_ENABLED=false            # 总开关；开启后 Control Plane 才连 Temporal
TEMPORAL_GRPC_ENDPOINT=127.0.0.1:7233   # Temporal gRPC 地址（SDK client）
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=worker-test   # 默认队列（V3.4 §1 worker-test）

# ── TLS / mTLS（默认关闭）──
TEMPORAL_TLS_ENABLED=false
TEMPORAL_TLS_CA_PATH=             # 如 certs/ca.crt
TEMPORAL_TLS_CERT_PATH=           # 如 certs/worker.crt（client 证书）
TEMPORAL_TLS_KEY_PATH=            # 如 certs/worker.key

# ── docker-compose（Temporal server / UI 端口）──
TEMPORAL_GRPC_PORT=7233
TEMPORAL_UI_PORT=8080              # Docker Desktop 占 8080 时改 8081

# ── docker-compose（PostgreSQL 持久化，V34-001；默认已内建表）──
POSTGRES_USER=temporal
POSTGRES_PASSWORD=temporal
POSTGRES_DB=temporal

# ── Worker 主机 ← start-worker.sh ──
BACKEND_URL=http://localhost:8000/api/v2
API_TOKEN=                         # 可选；worker 注册需要时提供
