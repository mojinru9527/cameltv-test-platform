# CamelTv sports UI automation. Copy to an ignored .env.<environment> file.

# Required fail-closed runtime identity.
CAMELTV_TARGET_ENV=test5
CAMELTV_BASE_URL=
CAMELTV_RUN_LEVEL=readonly
CAMELTV_ALLOWED_HOSTS=
CAMELTV_PRECONDITION_OWNER=

# Required authorized account. Never commit real values.
CAMELTV_USERNAME=
CAMELTV_PASSWORD=
CAMELTV_ACCOUNT_OWNER=

# Required stable business data. Values are identifiers/paths, never secrets.
CAMELTV_TEST_DATA_JSON={}
CAMELTV_DATA_OWNER=

# Comma-separated injected secret/PII canaries used to reject unsafe evidence.
CAMELTV_EVIDENCE_CANARIES=

# Midscene AI model configuration. Credentials/PII/raw responses are forbidden
# from AI instructions regardless of provider.
MIDSCENE_MODEL_BACKEND=qwen-vl
MIDSCENE_MODEL_API_KEY=

# Test5 proxy/VPN and runtime-only evidence location.
HTTP_PROXY=
CAPTURE_OUTPUT_DIR=../captured
