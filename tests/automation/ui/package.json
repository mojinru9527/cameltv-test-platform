{
  "name": "cameltv-ui-automation",
  "version": "1.0.0",
  "description": "CamelTv UI automation with midscene.js — AI-driven visual testing",
  "private": true,
  "scripts": {
    "test": "npx playwright test",
    "test:headed": "npx playwright test --headed",
    "test:test": "cross-env TEST_ENV=test playwright test",
    "test:prod": "cross-env TEST_ENV=prod playwright test",
    "test:security": "playwright test --config=playwright.security.config.ts",
    "typecheck": "tsc --noEmit",
    "report": "npx playwright show-report",
    "capture": "npx playwright test --reporter=json"
  },
  "dependencies": {
    "@midscene/web": "1.10.8",
    "@playwright/test": "^1.48.0",
    "dotenv": "^16.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "cross-env": "^7.0.3",
    "typescript": "^5.6.3"
  },
  "overrides": {
    "js-yaml": "4.3.0",
    "sharp": "0.35.0",
    "uuid": "11.1.1"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
