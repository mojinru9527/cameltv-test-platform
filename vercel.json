{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm --prefix test-platform-v2/frontend ci",
  "buildCommand": "npm --prefix test-platform-v2/frontend run build",
  "outputDirectory": "test-platform-v2/frontend/dist",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
